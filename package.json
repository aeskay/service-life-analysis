{
  "name": "crcp-service-life-analysis",
  "productName": "CRCP Service Life Analysis",
  "private": true,
  "version": "1.0.0",
  "description": "Native desktop application for CRCP pavement service life analysis",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:vite": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 vite",
    "dev:electron": "cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev:win": "powershell -ExecutionPolicy Bypass -File dev.ps1",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "electron": "electron .",
    "lint": "oxlint"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "papaparse": "^5.5.4",
    "plotly.js-dist-min": "^3.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.69.0",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.ttu.crcp-service-life",
    "productName": "CRCP Service Life Analysis",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    }
  }
}
